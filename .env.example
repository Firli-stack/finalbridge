# ==========================================================
# BridgeCom Environment Configuration Template
# Salin file ini menjadi '.env' jika ingin mengubah konfigurasi:
#   cp .env.example .env
# ==========================================================

# ── 1. Sumber Kamera & Video ──────────────────────────────
# 0 = Kamera Internal Laptop / USB Webcam
# 1 = Kamera Eksternal Kedua
# rtsp://... = IP Camera / CCTV RTSP Stream
CAMERA_SOURCE=0

# ── 2. Konfigurasi IoT & MQTT Broker ──────────────────────
DEVICE_ID=bridgecom-node-01
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883

# ── 3. MQTT Topics ─────────────────────────────────────────
MQTT_TOPIC_GESTURE=bridgecom/gesture/detected
MQTT_TOPIC_STATUS=bridgecom/device/status
MQTT_TOPIC_SENSOR=bridgecom/sensor/trigger